{
  "name": "Valve_Board26",
  "architecture": "stm32g4",
  "mcu": "stm32g491",
  "memory": {
    "flash_base": 134217728,
    "flash_size": 524288,
    "ram_regions": [{"name": "sram", "base": 536870912, "size": 114688}],
    "bootloader_size": 16384,
    "slot_a_base": 134234112,
    "slot_a_size": 475136,
    "erase_size": 2048,
    "write_alignment": 8,
    "sedsnet_pool": 8192,
    "delta_base": 134709248,
    "delta_size": 24576
  },
  "artifacts": {
    "elf": "build/Release_Script/Valve_Board26.elf",
    "bootloader_elf": "build/Release_Script/Valve_Board26Bootloader.elf",
    "firmware": "build/Release_Script/Valve_Board26.launchcore.img",
    "bootloader": "build/Release_Script/Valve_Board26Bootloader.bin",
    "factory": "build/Release_Script/Valve_Board26.factory.bin",
    "ota": "build/Release_Script/Valve_Board26.seds"
  },
  "board": {
    "strict_mmio": false,
    "clocks": [],
    "connections": [],
    "pins": [],
    "dma_routes": []
  },
  "traffic": {
    "iterations": 100000,
    "max_payload": 512,
    "queue_depth": 0,
    "immediate_dispatch": true
  },
  "ota": {
    "chunk_size": 512
  },
  "peripherals": [
    {
      "type": "pressure_transducer",
      "name": "valve_pressure",
      "max_psi": 5000,
      "failure_every": 997
    },
    {
      "type": "adc",
      "name": "pressure_adc",
      "model": "stm32_adc",
      "bus": "adc2",
      "bits": 12,
      "channels": 1,
      "channel_samples": [1638],
      "noise_lsb": 2,
      "disconnect_after": 950
    },
    {
      "type": "adc",
      "name": "valve_adc3",
      "model": "stm32_adc",
      "bus": "adc3",
      "bits": 12,
      "channels": 1,
      "channel_samples": [2048],
      "noise_lsb": 2
    }
  ],
  "execution": {
    "virtual_time_ms": 750,
    "sample_count": 5,
    "memory_probe_warmup_samples": 3,
    "require_stack_probe": true,
    "memory_probes": [
      {"name": "network_ready", "symbol": "g_telemetry_network_ready"},
      {"name": "peer_mask", "symbol": "g_telemetry_peer_mask"},
      {"name": "heartbeat_attempts", "symbol": "g_sim_heartbeat_attempts"},
      {"name": "heartbeat_ok", "symbol": "g_sim_heartbeat_ok"},
      {"name": "heartbeat_wire_tx", "symbol": "g_sim_heartbeat_wire_tx"},
      {"name": "heartbeat_fail", "symbol": "g_sim_heartbeat_fail"},
      {"name": "valve_commands_received", "symbol": "g_sim_valve_commands_received"},
      {"name": "valve_commands_executed", "symbol": "g_sim_valve_commands_executed"},
      {"name": "last_valve_command", "symbol": "g_sim_last_valve_command"},
      {"name": "pilot_valve_state", "symbol": "g_sim_pilot_valve_state"},
      {"name": "pilot_solenoid_result", "symbol": "g_sim_pilot_solenoid_result", "minimum": 0, "maximum": 0},
      {"name": "valve_aborted", "symbol": "g_sim_valve_aborted", "maximum": 0},
      {"name": "heartbeat_timeouts", "symbol": "safety_heartbeat_timeout_count", "maximum": 0},
      {"name": "continuity_abort_latches", "symbol": "safety_continuity_loss_latched_count", "maximum": 0},
      {"name": "groundstation_confirmation_received", "symbol": "g_sim_groundstation_confirmation_received"},
      {"name": "umbilical_status_ok", "symbol": "g_sim_umbilical_status_ok"},
      {"name": "pilot_open_status_wire_tx", "symbol": "g_sim_pilot_open_status_wire_tx"},
      {"name": "umbilical_status_fail", "symbol": "g_sim_umbilical_status_fail", "maximum": 0},
      {"name": "discovery_seen", "symbol": "g_telemetry_discovery_seen"},
      {"name": "timesync_valid", "symbol": "g_telemetry_timesync_valid"},
      {"name": "fdcan_rx", "symbol": "g_fdcan_rx_count"},
      {"name": "fdcan_tx_ok", "symbol": "g_fdcan_tx_ok_count"},
      {"name": "fdcan_tx_fail", "symbol": "g_fdcan_tx_fail_count", "maximum": 0},
      {"name": "pool_available", "symbol": "g_telemetry_pool_available", "max_end_drop": 2048},
      {"name": "pool_low_water", "symbol": "g_telemetry_pool_low_water", "minimum": 1024},
      {"name": "pool_fragments", "symbol": "g_telemetry_pool_fragments"},
      {"name": "allocations", "symbol": "g_telemetry_alloc_count"},
      {"name": "frees", "symbol": "g_telemetry_free_count"},
      {"name": "alloc_failure_request", "symbol": "g_telemetry_alloc_failure_request", "maximum": 0},
      {"name": "alloc_failure_available", "symbol": "g_telemetry_alloc_failure_available", "maximum": 0},
      {"name": "alloc_failure_fragments", "symbol": "g_telemetry_alloc_failure_fragments", "maximum": 0},
      {"name": "max_alloc_request", "symbol": "g_telemetry_max_alloc_request"},
      {"name": "main_stack_remaining", "symbol": "g_sim_main_stack_remaining", "minimum": 1024},
      {"name": "telemetry_stack_remaining", "symbol": "g_sim_telemetry_stack_remaining", "minimum": 1024},
      {"name": "data_acq_stack_remaining", "symbol": "g_sim_data_acq_stack_remaining", "minimum": 1024},
      {"name": "safety_stack_remaining", "symbol": "g_sim_safety_stack_remaining", "minimum": 512},
      {"name": "allocation_failures", "symbol": "g_telemetry_alloc_fail", "maximum": 0},
      {"name": "panics", "symbol": "g_telemetry_panic_count", "maximum": 0},
      {"name": "mutex_get_failures", "symbol": "g_telemetry_lock_get_fail", "maximum": 0},
      {"name": "mutex_put_failures", "symbol": "g_telemetry_lock_put_fail", "maximum": 0}
    ]
  }
}
